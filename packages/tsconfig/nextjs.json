{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "noEmit": true,
    "strictNullChecks": true
  },
  "include": ["src", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "out"]
}

{
  "name": "@autional-cn/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Autional shared layer — API client, auth, types, hooks, utils",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./generated/api": "./src/generated/api.ts",
    "./generated/types": "./src/generated/types.ts",
    "./generated/queries": "./src/generated/queries.ts",
    "./api": "./node_modules/@autional-cn/api-generated/api.ts",
    "./types": "./node_modules/@autional-cn/api-generated/types.ts",
    "./queries": "./node_modules/@autional-cn/api-generated/queries.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react --external react-dom",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react --external react-dom",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@autional-cn/api-generated": "file:../../scripts/generate/api-generated-package",
    "@opentelemetry/api": "1.9.1",
    "@tanstack/react-query": "5.100.9",
    "axios": "1.16.0",
    "lodash-es": "4.18.1",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@autional-cn/tsconfig": "workspace:*",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsup": "8.5.1",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
